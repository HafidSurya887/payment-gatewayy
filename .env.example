# Connection string MongoDB kamu
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/payment-gateway

# String mentah hasil decode QRIS statis (bukan gambarnya). Lihat README bagian 2.
QRIS_STATIS_STRING=00020101021126...ISI_DENGAN_STRING_ASLI...6304XXXX

# String rahasia bebas buat menandatangani token login merchant. Isi dengan string acak yang panjang.
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia

# Opsional: kalau diisi, endpoint /webhook/payment akan menolak request yang tidak
# menyertakan header "x-secret" dengan nilai yang sama persis (proteksi tambahan).
WEBHOOK_SECRET=
